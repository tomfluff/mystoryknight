# PORT and HOST are for local `python app.py` only. Do NOT set PORT on Cloud Run,
# it is a reserved variable that Cloud Run injects itself.
PORT=5000
HOST=0.0.0.0
# Never set DEBUG=True on a deployed instance: it exposes the Werkzeug debugger.
DEBUG=False

LOGGER=True

# Comma-separated list of allowed frontend origins.
# Production example: https://tomfluff.github.io
CORS_ORIGINS=http://localhost:3000

# Where generated story images go. Leave EMPTY for local development (writes to
# ./static). On Cloud Run set this to a bucket name: the instance filesystem is
# per-instance and RAM-backed, so local writes 404 from other instances and grow
# memory with no cleanup.
GCS_BUCKET=

# Open AI
OPENAI_API_KEY=your-api-key
OPENAI_ORG_ID=your-org-id
