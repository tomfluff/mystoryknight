# PORT and HOST are for local `python app.py` only. Do NOT set PORT on Cloud Run,
# it is a reserved variable that Cloud Run injects itself.
PORT=5000
HOST=0.0.0.0
# Never set DEBUG=True on a deployed instance: it exposes the Werkzeug debugger.
DEBUG=False

LOGGER=True

# Comma-separated list of allowed frontend origins.
# Production example: https://tomfluff.github.io
CORS_ORIGINS=http://localhost:3000

# Open AI
OPENAI_API_KEY=your-api-key
OPENAI_ORG_ID=your-org-id
